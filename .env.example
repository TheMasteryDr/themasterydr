# ===================================================
# THE MASTERY DR - Environment Configuration Template
# ===================================================

# Application Base
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Neon PostgreSQL Database Connection URL
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/themasterydr?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_samplepassword@ep-sample-12345.us-east-2.aws.neon.tech/themasterydr?sslmode=require

# Authentication Secrets
# Generate with: openssl rand -base64 32
AUTH_SECRET=the-mastery-dr-secure-auth-secret-key-32-chars-min
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (Optional for social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Paystack Payment Gateway (Live or Test keys)
# Get your keys at https://dashboard.paystack.com/#/settings/developer
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_sample_key_here
PAYSTACK_SECRET_KEY=sk_test_sample_key_here

# Transactional Email (Resend / SMTP)
EMAIL_SERVER_HOST=smtp.resend.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=resend
EMAIL_SERVER_PASSWORD=re_sample_api_key_here
EMAIL_FROM="The Mastery Dr <moses@gainmastery.org>"

# Community & Social Channels
NEXT_PUBLIC_TELEGRAM_COMMUNITY=https://t.me/masterymasterminds
NEXT_PUBLIC_INSTAGRAM=https://instagram.com/themasterydr
NEXT_PUBLIC_TIKTOK=https://tiktok.com/@themasterydr
NEXT_PUBLIC_FACEBOOK=https://facebook.com/themasterydr
NEXT_PUBLIC_CONTACT_EMAIL=moses@gainmastery.org
